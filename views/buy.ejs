<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buy</title>
  <link rel="stylesheet" href="/buy.css">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
  
  <div class="container">
    <img  class="image2"src="<%=data.image%>" alt="Item" width="200">
     <h2>Item:<%=data.item%></h2>
  <p>Price:<i class="fa-solid fa-indian-rupee-sign"></i><%=data.price%></p>
     
      <p>Quantity: <%=data.quantity%></p>
       
       
       <p>Description: <%=data.description%></p> 
      
     
      <a href="tel:+91<%=data.phone%>" 
   style="display:inline-block; background:green; color:white; padding:10px 20px; text-decoration:none; border-radius:5px;">
   📞 Call Now
</a>
  </div>
  
</body>
</html>