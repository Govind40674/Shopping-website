<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home</title>
  <link rel="stylesheet" href="/home.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
  <div id="preloader">
  <div class="loader">
    <img src="/images/logo.png" alt="Your Website Logo" />
        <img src="/images/loading.svg" alt="Loading Animation" />
  </div>
</div>
  <%-include('includes/header.ejs');%>
  <main>
   
   <%if(error){%>
     <p class="error"><%=error%></p>
  <% }%>
<% if(data){%>
       <%for(let datas of data){%> 
            <div class="container"> 
              <img  class="image2"src="<%=datas.image%>" alt="Item" width="200">
               <!-- <h2>Item:<%=datas.item%></h2> -->
               
                
                 <p>Price:<i class="fa-solid fa-indian-rupee-sign"></i><%=datas.price%></p>
               
                 
                 
                <a href="/buy/<%=datas._id%>"><button>Buy</button></a>
                
                 </div> 
                 <%}%> 

<%}%>

   
  </main>
  



  
</body>
<%-include('includes/footer.ejs');%>
<script>
  // Hide preloader when page fully loads
  window.addEventListener("load", function() {
    const preloader = document.getElementById("preloader");
    preloader.style.display = "none";
  });


    const isWebView = /wv/.test(navigator.userAgent) || /Android.*Version/.test(navigator.userAgent);

  if (!isWebView) {
    const btn = document.createElement("a");
    btn.href = "/spheremart.apk"; // your APK link
    btn.textContent = "📲 Download Android App";
    btn.setAttribute("download", "");

    // 💅 Styling for all screen sizes
    btn.style.cssText = `
      display: inline-block;
      background: linear-gradient(135deg, #007BFF, #00BFFF);
      color: white;
      padding: 14px 26px;
      border-radius: 40px;
      text-decoration: none;
      font-size: 16px;
      font-weight: 600;
      font-family: 'Poppins', sans-serif;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      transition: all 0.25s ease;
      position: fixed;
      left: 50%;
      transform: translateX(-50%);
      bottom: 90px; /* ⬅ lifted above footer */
      z-index: 9999;
      text-align: center;
      white-space: nowrap;
    `;

    // 💫 Hover effect
    btn.addEventListener("mouseover", () => {
      btn.style.transform = "translateX(-50%) scale(1.05)";
    });
    btn.addEventListener("mouseout", () => {
      btn.style.transform = "translateX(-50%) scale(1)";
    });

    document.body.appendChild(btn);

    // 📱 Adjust for smaller screens
    const styleTag = document.createElement("style");
    styleTag.textContent = `
      @media (max-width: 600px) {
        a[download] {
          font-size: 14px !important;
          padding: 12px 20px !important;
          bottom: 80px !important; /* slightly higher for mobile footers */
        }
      }
    `;
    document.head.appendChild(styleTag);

    // 🧠 Optional: auto-adjust if footer height changes
    window.addEventListener('scroll', () => {
      const footer = document.querySelector('footer');
      if (footer) {
        const footerTop = footer.getBoundingClientRect().top;
        const windowHeight = window.innerHeight;
        if (footerTop < windowHeight - 80) {
          btn.style.opacity = '0';
          btn.style.pointerEvents = 'none';
        } else {
          btn.style.opacity = '1';
          btn.style.pointerEvents = 'auto';
        }
      }
    });
  }




</script>



</html>