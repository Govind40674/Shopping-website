<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Previous</title>
  <link rel="stylesheet" href="/previoussellonline.css">
</head>
<body>
  <!-- Preloader -->
<div id="preloader">
  <div class="loader">
    <img src="/images/logo.png" alt="Your Website Logo" />
    <p>Loading GovindShop...</p>
  </div>
</div>

  <header>
 
    <a href="/">Home</a>
       <a href="/sold">Sell Online</a>
  </header>
<%for(let datas of data){%>
  <div class="container">
    <img src="<%=datas.image%>" alt="Item" width="200">
     <h2>Item:<%=datas.item%></h2>
     
      <p>Quantity: <%=datas.quantity%></p>
       <p>Price: <%=datas.price%></p>
       
       <p>Description: <%=datas.description%></p> 
       <p>Phone no: <%=datas.phone%></p>
       <p>State: <%=datas.state%></p>
       <p>City: <%=datas.city%></p>
       <p>Address: <%=datas.address%></p>
       <a href="/deleteonline/<%=datas._id%>">Delete</a>
      
       </div>
       <%}%>
  
</body>
<script>
  // Hide preloader when page fully loads
  window.addEventListener("load", function() {
    const preloader = document.getElementById("preloader");
    preloader.style.display = "none";
  });
</script>

</html>