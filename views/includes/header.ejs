<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/header.css">
</head>
<body>

  <header>
   
    <div class="icon">
      <img src="/images/logo.png" alt="Random image">
      <h1>SphereMart</h1>
      <div class="profile">
      <ul><i class="fa-regular fa-user"></i>
        <div class="dropdown">
          <a href="/show">Show Data</a>
    
    <a href="/adddata" >Add Data</a>
    
    <a href="/shortage">Shortage Record</a>
       <a href="/sold">Sell Online</a>
   <a href="/mail">Contact</a>
       <a href="/logout">Logout</a>

        </div>

      </ul>
    </div>
    </div>

 
     <input type="text" id="searchBox" class="search">
     
  </header>


 

  <script>
  document.getElementById("searchBox").addEventListener("keypress", function(event) {
  if (event.key === "Enter") {  // If Enter is pressed
    let query = this.value.trim();
    if (query) {
      window.location.href = "/search?q=" + encodeURIComponent(query);
    }
  }
});

  </script>
</body>
</html>