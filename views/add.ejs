<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add</title>
  <link rel="stylesheet" href="/add.css">
  
</head>
<body>
  <form method="POST" action="/adddata" class="container">
    <h1>Add Data</h1>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text"  spellcheck="false" name="item" placeholder="enter item name" class="item">
    <input type="text"  spellcheck="false"name="itemsize" placeholder="enter item size" class="item">
    <input type="text"  spellcheck="false"name="mrp" placeholder="enter mrp" class="item">
    <input type="text" spellcheck="false" name="sp" placeholder="enter selling price" class="item">
    <input type="text" spellcheck="false" name="sdi" placeholder="enter total sold item" class="item">
    <button>Submit</button>

    

    
  </form>
  
</body>
</html>