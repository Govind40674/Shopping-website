<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shortage</title>
  <link rel="stylesheet" href="/shortage.css">
</head>
<body>
  <div class="container">
      <h1>Shortage</h1>
    
   <a href="/shortageadd">Add Shortage</a>
  </div>
  


  <table>
    <thead>
      <tr class="item1">
        <th>Item</th>
        <th>Quantity</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% data.forEach(item => { %>
        <tr class="item">
          <td><%= item.item %></td>
          <td><%= item.quantity %></td>
         <td>
          <form action="/deleteshortage/<%= item._id %>" method="GET">
          <button>Delete</button>
         </form>
         </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  
</body>
</html>